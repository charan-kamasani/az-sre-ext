#!/usr/bin/env bash

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

python_candidates=()
if [ -n "${SRE_PYTHON:-}" ]; then
  python_candidates+=("$SRE_PYTHON")
fi
python_candidates+=(
  ".venv/bin/python"
  ".venv/Scripts/python.exe"
  "python3"
  "python"
)

python_command=""
for candidate in "${python_candidates[@]}"; do
  if command -v "$candidate" >/dev/null 2>&1 &&
      "$candidate" -c "import azure.cli.core" >/dev/null 2>&1; then
    python_command="$candidate"
    break
  fi
done

if [ -z "$python_command" ]; then
  echo "CLI reference generation requires azure-cli-core (see .github/workflows/ci.yml)." >&2
  exit 1
fi

"$python_command" scripts/generate_cli_reference.py
git add docs/cli-reference.md
"$python_command" scripts/generate_cli_reference.py --check
